# Google OAuth
GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here

# Django
SECRET_KEY=django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=ufazien.com,www.ufazien.com,allowed_host_3

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=db_name_here
DB_USER=db_user_here
DB_PASSWORD=supersecurepassword
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password

# Push Notifications (VAPID keys - generate with py-vapid)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate Limiting
DEFAULT_RATE_LIMIT=100
PREMIUM_RATE_LIMIT=1000